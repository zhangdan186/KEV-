{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prepared KEV row exported to CSV-compatible JSON",
  "type": "object",
  "required": [
    "cveID",
    "vendorProject",
    "product",
    "vulnerabilityName",
    "dateAdded",
    "shortDescription",
    "requiredAction",
    "dueDate",
    "knownRansomwareCampaignUse",
    "notes",
    "cwes",
    "vendor_clean",
    "product_clean",
    "added_year",
    "added_month",
    "deadline_days",
    "has_cwe",
    "cwe_count"
  ],
  "properties": {
    "cveID": {
      "type": "string",
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$"
    },
    "vendorProject": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "vulnerabilityName": {
      "type": "string"
    },
    "dateAdded": {
      "type": "string",
      "format": "date"
    },
    "shortDescription": {
      "type": "string"
    },
    "requiredAction": {
      "type": "string"
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "knownRansomwareCampaignUse": {
      "enum": [
        "Known",
        "Unknown"
      ]
    },
    "notes": {
      "type": "string"
    },
    "cwes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CWE-[0-9]+$"
      }
    },
    "vendor_clean": {
      "type": "string",
      "minLength": 1
    },
    "product_clean": {
      "type": "string",
      "minLength": 1
    },
    "added_year": {
      "type": "integer"
    },
    "added_month": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "deadline_days": {
      "type": "integer",
      "minimum": 0
    },
    "has_cwe": {
      "type": "boolean"
    },
    "cwe_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}